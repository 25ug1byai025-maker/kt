export async function analyzeText(text: string, tone: string) {
  const response = await fetch("http://127.0.0.1:8000/analyze", {
    method: "POST",
    headers: {
      "Content-Type": "application/json",
    },
    body: JSON.stringify({
      text,
      tone,
    }),
  });

  if (!response.ok) {
    throw new Error("Backend is playing hard to get 💔");
  }

  return response.json();
}
