from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel

app = FastAPI()

# Allow frontend access
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

class TextRequest(BaseModel):
    text: str
    tone: str

class TextResponse(BaseModel):
    improvedText: str
    corrections: list
    readabilityScore: int
    overallFeedback: str

@app.post("/analyze", response_model=TextResponse)
def analyze_text(data: TextRequest):
    # Dummy AI logic (replace with Gemini / OpenAI later 😉)
    improved = data.text.capitalize()

    return {
        "improvedText": improved,
        "corrections": [
            {
                "original": data.text,
                "replacement": improved,
                "reason": "Capitalized sentence start"
            }
        ],
        "readabilityScore": 85,
        "overallFeedback": f"Your writing looks confident and charming — just like you, sweetheart 😏"
    }
